# MongoDB Connection String (Replace with your own credentials)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/studentos?retryWrites=true&w=majority"

# JWT Token Secrets (Generate strong random secrets for production)
ACCESS_TOKEN_SECRET="your-jwt-access-token-secret"
REFRESH_TOKEN_SECRET="your-jwt-refresh-token-secret"

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# Server Port
PORT=5001

# Client API URL
VITE_API_URL="http://localhost:5001/api"
